# wrangler dev env for the local testnet. Copy to .dev.vars (gitignored).
# These are LOCAL-ONLY values, not credentials for anything deployed.

# Bearer shared with every local notary daemon (the same value goes into the
# daemon's env as MIGRATION_NOTARY_BEARER_TOKEN; automation/local wires it).
MIGRATION_NOTARY_BEARER_TOKEN=local-testnet-bearer

# Point the build axis (/v1/update-check latest_build) at the local artifact
# server, so a UI-release rehearsal can see its local patch build. Omit to read
# the releases wrangler.local.toml names.
# GITHUB_RELEASES_URL=http://localhost:8788/releases

# CF-Access service-token creds are DELIBERATELY absent: the router only adds
# CF-Access headers when both are set, and local daemons sit behind no tunnel.
