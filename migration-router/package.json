{
  "name": "migration-router",
  "version": "0.1.0",
  "private": true,
  "description": "Cloudflare Worker router for unyt DNA migration",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "dev:local": "node -e \"const fs=require('fs');fs.existsSync('registry.local.json')||fs.copyFileSync('registry.local.example.json','registry.local.json');fs.existsSync('.dev.vars')||fs.copyFileSync('.dev.vars.example','.dev.vars')\" && wrangler dev -c wrangler.local.toml",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.5.0",
    "@cloudflare/workers-types": "^4.20240909.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0",
    "wrangler": "^3.78.0"
  }
}
